{
  "base_model": "Qwen/Qwen3-1.7B",
  "base_revision": "70d244cc86ccca08cf5af4e1e306ecf908b1ad5e",
  "weights_dtype": "float16",
  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  },
  "adapter_dtype": "float32",
  "autocast_dtype": "float16",
  "grad_scaler": true,
  "gradient_checkpointing": true,
  "cuda_memory_limit_gib": 10.0,
  "max_seq_len": 8192,
  "micro_batch_size": 1,
  "grad_accum": 16,
  "lr": 1e-4,
  "schedule": "cosine",
  "warmup_ratio": 0.03,
  "adam_betas": [0.9, 0.999],
  "weight_decay": 0.0,
  "max_grad_norm": 1.0,
  "epochs": 2,
  "seed": 0,
  "log_every": 10,
  "eval_every": 100,
  "train_data": "data/sft/v2/train.jsonl",
  "val_data": "data/sft/v2/val.jsonl",
  "out_dir": "runs/sft-preview",
  "stop": {
    "max_hours": 12,
    "min_scale": 1.0,
    "max_consecutive_skipped_steps": 10,
    "max_skipped_fraction": 0.05,
    "estimate_after_steps": 20
  }
}
