  "vllm": {
    "dtype": "half",
    "max_model_len": 8192,
    "gpu_memory_utilization": 0.85,
    "port": 8000,
    "max_lora_rank": 16,
    "max_loras": 1,
    "seed": 0,
    "memory_mode": "sleep",
    "sleep_level": 2,
